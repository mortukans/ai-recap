# React Native + Metro require a flat, hoisted node_modules layout.
# Without this, native module resolution and Metro break under pnpm.
node-linker=hoisted
# Expo/RN autolinking scans node_modules; make sure hoisted patterns cover everything.
public-hoist-pattern[]=*
# Keep peer-dependency resolution lenient (RN ecosystem has many loose peers).
strict-peer-dependencies=false
