# Copy to .env and fill in. These are read by app.config.ts `extra`.
# The Supabase anon key is RLS-safe to ship in the client; never put service-role keys here.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys (M5). Safe to ship.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
