# Upload App Store screenshots to an already-prepared App Store version via the
# App Store Connect API. Screenshots only — no binary, no text metadata, no submit.
# The portrait screenshot carousel cannot be uploaded through the ASC web UI by
# automation (its drop zone opens a native OS file dialog), so this is the path.
# Secrets come from the repo (same App Store Connect API key used to upload builds).
default_platform(:ios)

platform :ios do
  desc "Upload App Store screenshots to the prepared version (screenshots only)"
  lane :screenshots do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_API_KEY_ID"),
      issuer_id: ENV.fetch("ASC_API_ISSUER_ID"),
      key_content: ENV.fetch("ASC_API_KEY_BASE64"),
      is_key_content_base64: true,
      in_house: false,
    )

    deliver(
      api_key: api_key,
      app_identifier: "lv.airecap.app",
      app_version: ENV.fetch("APP_VERSION", "1.1.2"),
      platform: "ios",
      screenshots_path: "./fastlane/screenshots",
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true,
    )
  end
end
